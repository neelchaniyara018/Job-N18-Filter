{
  "manifest_version": 3,
  "name": "Job Search Agent — Neel",
  "description": "One-click job search: Naukri, LinkedIn, Indeed & Internshala. Real browser — no CAPTCHA blocks.",
  "version": "1.0",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://*.naukri.com/*",
    "https://*.indeed.com/*",
    "https://www.linkedin.com/*",
    "https://internshala.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Open Job Search Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
